# Apache configuration: /etc/httpd/conf.d/gwms-web.conf

# ITB configuration (internal servers and HTTP ports)
# fac: host1.your.dom:8080
# fe:  host2.your.dom

<Location /itb/factory>
 ProxyPass http://host1.your.dom:8080/factory
 ProxyPassReverse http://host1.your.dom:8080/factory
</Location>

<Location /itb/vofrontend>
 ProxyPass http://host2.your.dom/vofrontend
 ProxyPassReverse http://host2.your.dom/vofrontend
</Location>


# User setup
# Factory and Frontend run in containers (using compose) on userhost.your.dom

<Location /user/factory>
 ProxyPass http://userhost.your.dom:30080/factory
 ProxyPassReverse http://userhost.your.dom:30080/factory
</Location>

<Location /user/vofrontend>
 ProxyPass http://userhost.your.dom:40080/vofrontend
 ProxyPassReverse http://userhost.your.dom:40080/vofrontend
</Location>

